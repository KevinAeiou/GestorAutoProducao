<resources>
    <style name="Theme.GestorAutoProducao" parent="Theme.Material3.DayNight">
        <!-- Primary -->
        <item name="colorPrimary">@color/cor_azul</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary -->
        <item name="colorSecondary">@color/cor_laranja</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Containers -->
        <item name="colorPrimaryContainer">@color/cor_azul</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <item name="colorSecondaryContainer">@color/cor_laranja</item>
        <item name="colorOnSecondaryContainer">@color/white</item>

        <!-- Componentes -->
        <item name="radioButtonStyle">@style/CustomRadioButton</item>
        <item name="floatingActionButtonStyle">@style/Widget.Material3.FloatingActionButton.Secondary</item>
        <item name="materialButtonStyle">@style/Widget.Material3.Button</item>
        <item name="textInputStyle">@style/txtInputLayout</item>
    </style>

    <style name="Theme.GestorAutoProducao.NoActionBar" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/cor_azul</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/cor_laranja</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Containers -->
        <item name="colorPrimaryContainer">@color/cor_azul</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <item name="colorSecondaryContainer">@color/cor_laranja</item>
        <item name="colorOnSecondaryContainer">@color/white</item>

        <!-- Componentes -->
        <item name="radioButtonStyle">@style/CustomRadioButton</item>
        <item name="floatingActionButtonStyle">@style/Widget.Material3.FloatingActionButton.Secondary</item>
        <item name="materialButtonStyle">@style/Widget.Material3.Button</item>
        <item name="textInputStyle">@style/txtInputLayout</item>
        <item name="android:dialogTheme">@style/CustomAlertDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/CustomAlertDialogTheme</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Material3.DayNight.BottomSheetDialog</item>
        <item name="autoCompleteTextViewStyle">@style/CustomAutoCompleteTextView</item>
        <item name="switchStyle">@style/Widget.Material3.CompoundButton.MaterialSwitch</item>
    </style>
</resources>