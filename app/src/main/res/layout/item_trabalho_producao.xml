<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/card"
    app:cardBackgroundColor="?attr/colorSurface"
    android:paddingStart="0dp"
    android:paddingEnd="0dp"
    android:id="@+id/itemCardViewTrabalho">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingEnd="16dp">

        <View
            android:id="@+id/itemEstadoTarja"
            android:layout_width="5dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:background="@color/cor_estado_produzindo_tarja" />

        <ImageView
            android:id="@+id/itemSelecionadoIcone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginBottom="16dp"
            android:importantForAccessibility="no"
            android:visibility="gone"
            android:src="@drawable/ic_check_circle"
            app:tint="?attr/colorPrimary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/itemNomeTrabalho"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="21dp"
            android:layout_marginTop="16dp"
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            tools:text="Trabalho"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/itemNivelContainer"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/itemNivelContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/cor_primaria_transparente"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/itemNivelTrabalho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="12sp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textColor="?attr/colorPrimary"
                tools:text="10"/>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/itemEstadoBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="21dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="8dp"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/itemNomeTrabalho">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/itemEstadoIcone"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:importantForAccessibility="no"
                    tools:src="@drawable/ic_estado_produzindo"/>

                <TextView
                    android:id="@+id/itemEstadoTexto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Produzindo"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/itemTipoLicenca"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/itemEstadoBadge"
            app:layout_constraintTop_toBottomOf="@id/itemEstadoBadge"
            tools:text="Licença" />

        <TextView
            android:id="@+id/itemProfissaoTrabalho"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintEnd_toEndOf="@id/itemTipoLicenca"
            app:layout_constraintStart_toStartOf="@id/itemTipoLicenca"
            app:layout_constraintTop_toBottomOf="@id/itemTipoLicenca"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="Profissão" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
