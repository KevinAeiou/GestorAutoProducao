<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include layout="@layout/status_conexao" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewTrabalhoProducao"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Identidade: mesmo padrao dos cards da lista de producao (tarja de estado + nome por raridade + selo de nivel) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHeroTrabalho"
                style="@style/card"
                app:cardBackgroundColor="?attr/colorSurface"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                android:layout_marginTop="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingEnd="16dp">

                    <View
                        android:id="@+id/heroRaridadeTarja"
                        android:layout_width="5dp"
                        android:layout_height="0dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        tools:background="@color/cor_estado_produzindo_tarja" />

                    <TextView
                        android:id="@+id/txtNomeTrabalho"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="21dp"
                        android:layout_marginTop="16dp"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="?attr/colorOnSurface"
                        app:layout_constraintEnd_toStartOf="@+id/heroNivelContainer"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="Trabalho" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/heroNivelContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/cor_primaria_transparente"
                        app:strokeWidth="0dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <TextView
                            android:id="@+id/txtNivelTrabalho"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:textColor="?attr/colorPrimary"
                            tools:text="Nv 10" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/heroEstadoSelo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="21dp"
                        android:layout_marginTop="10dp"
                        app:cardCornerRadius="8dp"
                        app:strokeWidth="0dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtNomeTrabalho">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="8dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp">

                            <ImageView
                                android:id="@+id/heroEstadoIcone"
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:importantForAccessibility="no"
                                tools:src="@drawable/ic_estado_produzindo" />

                            <TextView
                                android:id="@+id/heroEstadoTexto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="Produzindo" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/txtLicencaHero"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="21dp"
                        android:layout_marginTop="8dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/heroEstadoSelo"
                        tools:text="Licença de Artesanato de Aprendiz"
                        tools:textColor="@color/cor_producao_licenca_aprendiz" />

                    <TextView
                        android:id="@+id/txtProfissaoTrabalho"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginStart="21dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtLicencaHero"
                        app:layout_constraintBottom_toBottomOf="parent"
                        tools:text="Profissão" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Metadados: linhas com divisor no lugar das caixas repetidas -->
            <com.google.android.material.card.MaterialCardView
                style="@style/card"
                app:cardBackgroundColor="?attr/colorSurface"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/rotuloMetadado"
                        android:text="@string/stringNomeProducao" />

                    <TextView
                        android:id="@+id/txtNomeProducaoTrabalho"
                        style="@style/valorMetadado"
                        tools:text="Espada Longa de Aço #12" />

                    <View style="@style/divisorMetadado" />

                    <TextView
                        style="@style/rotuloMetadado"
                        android:text="@string/stringExperiencia" />

                    <TextView
                        android:id="@+id/txtExperienciaTrabalho"
                        style="@style/valorMetadado"
                        tools:text="3.200" />

                    <View style="@style/divisorMetadado" />

                    <LinearLayout
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/rotuloMetadado"
                                android:text="@string/stringCriadoEm" />

                            <TextView
                                android:id="@+id/txtCriadoEmTrabalho"
                                style="@style/valorMetadado"
                                tools:text="03/09/2026 14:20" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/rotuloMetadado"
                                android:text="@string/stringModificadoEm" />

                            <TextView
                                android:id="@+id/txtModificadoEmTrabalho"
                                style="@style/valorMetadado"
                                tools:text="10/09/2026 09:05" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutDatas2Producao"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View style="@style/divisorMetadado" />

                        <LinearLayout
                            android:baselineAligned="false"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/rotuloMetadado"
                                    android:text="@string/stringIniciadoEm" />

                                <TextView
                                    android:id="@+id/txtIniciadoEmTrabalho"
                                    style="@style/valorMetadado"
                                    tools:text="10/09/2026 09:05" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/rotuloMetadado"
                                    android:text="@string/stringFinalizadoEm" />

                                <TextView
                                    android:id="@+id/txtFinalizadoEmTrabalho"
                                    style="@style/valorMetadado"
                                    tools:text="Não finalizado" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Configuracao: estado como seletor colorido reaproveitando as cores do selo -->
            <com.google.android.material.card.MaterialCardView
                style="@style/card"
                app:cardBackgroundColor="?attr/colorSurface"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="16sp"
                            android:textColor="?attr/colorOnSurface"
                            android:text="@string/stringRecorrente" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchRecorrenciaDetalhesTrabalho"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:thumbIcon="@drawable/ic_switch_thumb_checked"
                            app:thumbIconTint="?attr/colorPrimary" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/txtLayoutLicencaTrabalho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="@string/stringLicenca"
                        app:endIconMode="dropdown_menu">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/txtAutoCompleteLicencaTrabalho"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:textStyle="bold"
                            android:text="@string/stringLicenca" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/rotuloMetadado"
                        android:layout_marginTop="16dp"
                        android:text="@string/string_estado" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/chipEstadoParaProduzir"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="12dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="?attr/colorOutlineVariant">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center"
                                android:padding="10dp">

                                <ImageView
                                    android:id="@+id/iconeChipParaProduzir"
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:layout_marginEnd="4dp"
                                    android:importantForAccessibility="no"
                                    android:visibility="gone"
                                    tools:src="@drawable/ic_estado_feito" />

                                <TextView
                                    android:id="@+id/txtChipParaProduzir"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:text="@string/stringFiltroParaProduzir" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/chipEstadoProduzindo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="12dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="?attr/colorOutlineVariant">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center"
                                android:padding="10dp">

                                <ImageView
                                    android:id="@+id/iconeChipProduzindo"
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:layout_marginEnd="4dp"
                                    android:importantForAccessibility="no"
                                    android:visibility="gone"
                                    tools:src="@drawable/ic_estado_feito" />

                                <TextView
                                    android:id="@+id/txtChipProduzindo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:text="@string/stringFiltroProduzindo" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/chipEstadoFeito"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="12dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="?attr/colorOutlineVariant">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center"
                                android:padding="10dp">

                                <ImageView
                                    android:id="@+id/iconeChipFeito"
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:layout_marginEnd="4dp"
                                    android:importantForAccessibility="no"
                                    android:visibility="gone"
                                    tools:src="@drawable/ic_estado_feito" />

                                <TextView
                                    android:id="@+id/txtChipFeito"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:text="@string/stringFiltroFeito" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Acoes: excluir com peso secundario, confirmar como acao primaria -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExcluiTrabalho"
                    style="@style/BotaoAcaoDestrutiva"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stringExcluir"
                    app:icon="@drawable/ic_delete" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConfirmarProducao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/stringConfirmar" />

                    <include
                        android:id="@+id/loadingDotsConfirmar"
                        layout="@layout/view_loading_dots"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
